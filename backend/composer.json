{
  "name": "moodle/user-import",
  "description": "Shared backend for the Moodle user import web and CLI applications.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Application\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Application\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": [
      "@php -l src/Application.php",
      "@php -l src/Database/ConnectionFactory.php",
      "@php -l src/Database/SchemaManager.php",
      "@php -l src/Database/Exception/DatabaseConfigurationException.php",
      "@php -l src/Database/Exception/DatabaseConnectionException.php",
      "@php -l src/Database/Exception/SchemaManagementException.php",
      "@php -l tests/bootstrap.php",
      "@php -l tests/Smoke/ApplicationTest.php",
      "@php -l tests/Unit/Database/ConnectionFactoryTest.php",
      "@php -l tests/Unit/Database/SchemaManagerTest.php",
      "@php -l tests/Integration/Database/ConnectionFactoryTest.php",
      "@php -l tests/Integration/Database/SchemaManagerTest.php"
    ]
  },
  "config": {
    "sort-packages": true
  }
}

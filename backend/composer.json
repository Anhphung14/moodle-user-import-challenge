{
  "name": "moodle/user-import",
  "description": "Shared backend for the Moodle user import web and CLI applications.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Application\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Application\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff --verbose --sequential --using-cache=no",
        "format": "php-cs-fixer fix --sequential --using-cache=no",
        "analyse": "phpstan analyse --no-progress --debug --memory-limit=512M",
    "check": [
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  }
}

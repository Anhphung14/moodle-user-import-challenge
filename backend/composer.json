{
  "name": "moodle/user-import",
  "description": "Shared backend for the Moodle user import web and CLI applications.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Application\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Application\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": [
      "@php -l src/Application.php",
      "@php -l src/Database/ConnectionFactory.php",
      "@php -l src/Database/SchemaManager.php",
      "@php -l src/Database/Exception/DatabaseConfigurationException.php",
      "@php -l src/Database/Exception/DatabaseConnectionException.php",
      "@php -l src/Database/Exception/SchemaManagementException.php",
      "@php -l src/Csv/CsvUserParser.php",
      "@php -l src/Csv/Exception/CsvParsingException.php",
      "@php -l src/Domain/UserRecord.php",
      "@php -l src/Domain/ValidationError.php",
      "@php -l src/Domain/ValidatedUserRecord.php",
      "@php -l src/Domain/ImportPreview.php",
      "@php -l src/Domain/ImportResult.php",
      "@php -l src/Service/UserNormalizer.php",
      "@php -l src/Service/UserValidator.php",
      "@php -l src/Service/DuplicateEmailDetector.php",
      "@php -l src/Service/DatabaseDuplicateEmailDetector.php",
      "@php -l src/Repository/UserRepository.php",
      "@php -l src/Repository/PostgresUserRepository.php",
      "@php -l tests/bootstrap.php",
      "@php -l tests/Smoke/ApplicationTest.php",
      "@php -l tests/Unit/Database/ConnectionFactoryTest.php",
      "@php -l tests/Unit/Database/SchemaManagerTest.php",
      "@php -l tests/Unit/Csv/CsvUserParserTest.php",
      "@php -l tests/Unit/Domain/UserRecordTest.php",
      "@php -l tests/Unit/Domain/ValidatedUserRecordTest.php",
      "@php -l tests/Unit/Domain/ImportPreviewTest.php",
      "@php -l tests/Unit/Domain/ImportResultTest.php",
      "@php -l tests/Unit/Service/UserNormalizerTest.php",
      "@php -l tests/Unit/Service/UserValidatorTest.php",
      "@php -l tests/Unit/Service/DuplicateEmailDetectorTest.php",
      "@php -l tests/Unit/Service/DatabaseDuplicateEmailDetectorTest.php",
      "@php -l tests/Unit/Repository/PostgresUserRepositoryTest.php",
      "@php -l tests/Integration/Database/ConnectionFactoryTest.php",
      "@php -l tests/Integration/Database/SchemaManagerTest.php",
      "@php -l tests/Integration/Repository/PostgresUserRepositoryTest.php",
      "@php -l tests/Integration/Service/DatabaseDuplicateEmailDetectorTest.php"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
